# Standalone package graph generated by drvgo.
{ toolchain ? import ./resolved-toolchain.nix }:
let
  graph = builtins.fromJSON (builtins.readFile ./evaluation.json);
  sources = builtins.mapAttrs (id: hash: toString (builtins.path {
    path = ./sources + "/${id}";
    name = "go-source";
    sha256 = hash;
  })) graph.sourceHashes;
  scripts = import ./scripts.nix units sources;
  units = builtins.listToAttrs (map (u: {
    name = u.id;
    value = let
      tc = if u.native then toolchain.native or toolchain
        else if u.binary then toolchain.link or toolchain
        else toolchain.compile or toolchain;
    in builtins.derivation ({
      name = "go-" + builtins.replaceStrings [ "/" "@" "+" ] [ "-" "-" "-" ] u.name;
      system = graph.system;
      builder = "${tc}/bin/drvgo-builder";
      PATH = "${tc}/bin";
      GOROOT = "${tc}/share/go";
      GOOS = graph.goos;
      GOARCH = graph.goarch;
      CGO_ENABLED = graph.cgo;
      GOENV = "off";
      GOTOOLCHAIN = "local";
      isBinary = if u.binary then "1" else "0";
      binaryName = if u.binary then graph.binaryName else "";
      # File-backed scripts avoid Linux's per-argument size limit on large graphs.
      passAsFile = [ "script" ];
      script = scripts.${u.id};
      # Replay resolves @GOROOT@ and @TOOLCHAIN@ using this worker bundle.
      toolchainInput = tc;
    } // (if (u.storeReferences or []) == [] then {} else {
      # Source snapshots and encoded scripts do not retain Nix string context.
      # Make embedded runtime paths eligible for output reference scanning.
      runtimeReferences = map (path: builtins.appendContext path {
        ${path} = { path = true; };
      }) (u.storeReferences or []);
      passAsFile = [ "script" "runtimeReferences" ];
    }));
  }) graph.units);
in {
  inherit units;
  default = units.${graph.root};
}
